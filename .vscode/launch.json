{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "MedLingo Server (Vite + Express)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "env": {
        "PORT": "3000",
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run MedLingo Test Suite",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "tests/run_tests.ts"],
      "console": "integratedTerminal"
    }
  ]
}
